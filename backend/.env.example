# Copy to backend/.env (ignored by Git). Never put these in VITE_* variables.
LOCAL_DATABASE_URL=postgresql+psycopg://retinagram:<password>@localhost:5432/retinagram
# DATABASE_URL is accepted as a legacy alias when LOCAL_DATABASE_URL is unset.
CLOUD_DATABASE_URL=
# No provider ships yet. Setting a cloud URL alone does not enable uploads.
RETINA_CLOUD_SYNC_ENABLED=false
# The server must already use an app-owned data directory, preferably:
# C:\ProgramData\RetinaGram\postgres-data
# Alternate supported parent: %APPDATA%\RetinaGram CPU\
# The app checks SHOW data_directory. It never initializes or deletes a cluster.
