# Only the audited production weights belong in the default release
/src/checkpoints/*
!/src/checkpoints/iqa_int8.onnx
!/src/checkpoints/nafnet_fp16.onnx
!/src/checkpoints/lesion_bf16_cam.pt
!/src/checkpoints/grade_bf16_cam.pt
!/src/checkpoints/MODEL_MANIFEST.json
!/src/checkpoints/README.md
/scripts/*_report.json

# Keep portable Graphify outputs, exclude interpreter/cache/temp state
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/graph.html
!/graphify-out/graphify.html
!/graphify-out/README.md
